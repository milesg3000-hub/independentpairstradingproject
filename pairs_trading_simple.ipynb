   "source": [
    "# Assemble comparison table\n",
    "comparison = pd.DataFrame({\n",
    "    'Static (Gross)':   pd.Series(static_metrics_gross),\n",
    "    'Static (Net)':     pd.Series(static_metrics_net),\n",
    "    'Dynamic (Gross)':  pd.Series(dynamic_metrics_gross),\n",
    "    'Dynamic (Net)':    pd.Series(dynamic_metrics_net)\n",
    "})\n",
    "# Aesthetic: format as percentages where appropriate\n",
    "display_cols = ['Ann Return','Ann Vol','Max Drawdown','Win Rate']\n",
    "other_cols = ['Sharpe','Sortino','Calmar','Profit Factor']\n",
    "\n",
    "# Formatting\n",
    "format_dict = {}\n",
    "for col in comparison.columns:\n",
    "    for metric in display_cols:\n",
    "        if metric in comparison.index:\n",
    "            format_dict[(metric, col)] = \"{:.2%}\".format\n",
    "    for metric in other_cols:\n",
    "        if metric in comparison.index:\n",
    "            format_dict[(metric, col)] = \"{:.2f}\".format\n",
    "\n",
    "comparison_styled = comparison.style.format(format_dict, na_rep='-')\n",
    "display(comparison_styled)"
   ]
