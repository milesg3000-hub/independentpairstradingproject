   "source": [
    "window = 60          # Minimum spread observations before first GARCH fit\n",
    "refit_freq = 20      # Refit GARCH every 20 trading days\n",
    "# GARCH(1,1) on the level of the dynamic spread (mean zero)\n",
    "# note dynamic_spread_bt is already defined (log_KO - (alpha_t + beta_t * log_PEP))\n",
    "conditional_vol = pd.Series(np.nan, index=dynamic_spread_bt.index)\n",
    "\n",
    "for i in range(window, len(dynamic_spread_bt)):\n",
    "    idx = dynamic_spread_bt.index[i]           # current date\n",
    "\n",
    "    # Refit the GARCH model periodically\n",
    "    if (i - window) % refit_freq == 0 or i == window:\n",
    "        # Training data: all past spread levels before current index (0 .. i-1)\n",
    "        train_data = dynamic_spread_bt.iloc[:i]\n",
    "        try:\n",
    "            # GARCH(1,1) with zero mean – the spread is already centred at zero\n",
    "            garch = arch_model(train_data, p=1, q=1, vol='Garch', \n",
    "                               mean='Zero', dist='normal')\n",
    "            res = garch.fit(disp='off')\n",
    "        except:\n",
    "            continue\n",
    "\n",
    "    try:\n",
    "        # 1-step-ahead conditional variance forecast for the current point\n",
    "        forecast = res.forecast(horizon=1, align='origin')\n",
    "        forecast_var = forecast.variance.iloc[-1, 0]\n",
    "        conditional_vol.loc[idx] = np.sqrt(forecast_var)\n",
    "    except:\n",
    "        conditional_vol.loc[idx] = np.nan\n",
    "# Trading signal: spread level / conditional standard deviation\n",
    "signal_dynamic = dynamic_spread_bt / conditional_vol\n",
    "# Generate positions using signal_dynamic\n",
    "position_bt = pd.Series(0, index=backtest_index)\n",
    "current_position = 0\n",
    "\n",
    "for i in range(window, len(signal_dynamic)):\n",
    "    idx = signal_dynamic.index[i]\n",
    "    z = signal_dynamic.iloc[i]\n",
    "\n",
    "    if pd.isna(z):\n",
    "        continue\n",
    "\n",
    "    if current_position == 0:\n",
    "        if z >= 2.0:\n",
    "            current_position = -1   # Short the spread\n",
    "        elif z <= -2.0:\n",
    "            current_position = 1    # Long the spread\n",
    "\n",
    "    elif current_position == 1:\n",
    "        if z >= 0:\n",
    "            current_position = 0    # Close long\n",
    "\n",
    "    elif current_position == -1:\n",
    "        if z <= 0:\n",
    "            current_position = 0    # Close short\n",
    "\n",
    "    position_bt.loc[idx] = current_position\n",
    "\n",
    "# Merge into the main DataFrame\n",
    "log_prices_test[\"Position\"] = 0.0\n",
    "log_prices_test.loc[position_bt.index, \"Position\"] = position_bt"
   ]
