   "source": [
    "# Transaction cost analysis - backtest\n",
    "\n",
    "# Set a transaction cost \n",
    "cost_per_trade = 0.0005 # 5 basis points per trade (entry or exit)\n",
    "# Generate static strategy positions\n",
    "position_static = pd.Series(0.0, index=spread.index)\n",
    "current_position = 0\n",
    "for i in range(len(spread)):\n",
    "    t_val = t_stat_bt.iloc[i]          # EWMA t-stat \n",
    "    if pd.isna(t_val):\n",
    "        continue\n",
    "\n",
    "    if current_position == 0:\n",
    "        if t_val >= 2.0:\n",
    "            current_position = -1      # Short spread\n",
    "        elif t_val <= -2.0:\n",
    "            current_position = 1       # Long spread\n",
    "\n",
    "    elif current_position == 1:\n",
    "        if t_val >= 0:\n",
    "            current_position = 0\n",
    "\n",
    "    elif current_position == -1:\n",
    "        if t_val <= 0:\n",
    "            current_position = 0\n",
    "\n",
    "    position_static.iloc[i] = current_position\n",
    "\n",
    "# Compute continously compounded spread returns\n",
    "static_spread_returns = spread.diff() \n",
    "dynamic_spread_returns = dynamic_spread_bt.diff()\n",
    "# Strategy returns (gross) – same logic: lagged position × spread return\n",
    "strategy_returns_static_gross = position_static.shift(1) * static_spread_returns\n",
    "strategy_returns_dynamic_gross = position_bt.shift(1) * dynamic_spread_returns\n",
    "# Transaction cost deduction\n",
    "trade_cost_static = position_static.diff().abs() * cost_per_trade\n",
    "trade_cost_dynamic = position_bt.diff().abs() * cost_per_trade\n",
    "\n",
    "strategy_returns_static_net = strategy_returns_static_gross - trade_cost_static\n",
    "strategy_returns_dynamic_net = strategy_returns_dynamic_gross - trade_cost_dynamic\n",
    "# Performance metrics function\n",
    "def compute_metrics(returns, ann_factor=252):\n",
    "    \"\"\"\n",
    "    returns: pd.Series of continuously compounded strategy returns.\n",
    "    \"\"\"\n",
    "    # Drop initial NaN periods (before first position change)\n",
    "    clean_ret = returns.dropna()\n",
    "    if len(clean_ret) == 0:\n",
    "        return {k: np.nan for k in ['Ann Return','Ann Vol','Sharpe','Sortino',\n",
    "                                     'Max Drawdown','Calmar','Win Rate','Profit Factor']}\n",
    "    \n",
    "    ann_return = clean_ret.mean() * ann_factor\n",
    "    ann_vol = clean_ret.std() * np.sqrt(ann_factor)\n",
    "    sharpe = ann_return / ann_vol if ann_vol > 0 else np.nan\n",
    "    \n",
    "    # Sortino ratio: downside deviation only\n",
    "    downside = clean_ret[clean_ret < 0].std() * np.sqrt(ann_factor)\n",
    "    sortino = ann_return / downside if downside > 0 else np.nan\n",
    "    \n",
    "    # Cumulative wealth (initial capital = 1)\n",
    "    cum_wealth = clean_ret.cumsum().apply(np.exp)\n",
    "    running_max = cum_wealth.expanding().max()\n",
    "    drawdown = (cum_wealth - running_max) / running_max\n",
    "    max_dd = drawdown.min()\n",
    "    calmar = ann_return / abs(max_dd) if max_dd != 0 else np.nan\n",
    "    \n",
    "    win_rate = (clean_ret > 0).mean()\n",
    "    profit_factor = (clean_ret[clean_ret > 0].sum() / \n",
    "                     abs(clean_ret[clean_ret < 0].sum())) if clean_ret[clean_ret < 0].sum() != 0 else np.nan\n",
    "    \n",
    "    return {\n",
    "        'Ann Return': ann_return,\n",
    "        'Ann Vol': ann_vol,\n",
    "        'Sharpe': sharpe,\n",
    "        'Sortino': sortino,\n",
    "        'Max Drawdown': max_dd,\n",
    "        'Calmar': calmar,\n",
    "        'Win Rate': win_rate,\n",
    "        'Profit Factor': profit_factor\n",
    "    }"
   ]
  },
