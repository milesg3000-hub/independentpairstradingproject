    "plt.axhline(y=2, color='green', linestyle='--', linewidth=1, label='+2 / -2 thresholds')\n",
    "plt.axhline(y=-2, color='red', linestyle='--', linewidth=1)\n",
    "plt.xlabel(\"Date\")\n",
    "plt.ylabel(\"t-statistic\")\n",
