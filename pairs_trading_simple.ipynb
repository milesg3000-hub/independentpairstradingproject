    "# Cumulative wealth plot (net of costs)\n",
    "plt.figure(figsize=(12, 6))\n",
    "\n",
    "# Align indices for plotting (both start from backtest_index effectively)\n",
    "cum_static = strategy_returns_static_net.dropna().cumsum().apply(np.exp)\n",
    "cum_dynamic = strategy_returns_dynamic_net.dropna().cumsum().apply(np.exp)\n",
    "\n",
    "plt.plot(cum_static.index, cum_static, label='Static Spread (Net)', color='red')\n",
    "plt.plot(cum_dynamic.index, cum_dynamic, label='Dynamic Spread (Net)', color='blue')\n",
    "plt.axhline(1, color='black', linestyle='--', linewidth=0.8)\n",
    "plt.title('Cumulative Wealth (Net of Transaction Costs)')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Growth of $1')\n",
    "plt.legend()\n",
    "plt.grid(alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
